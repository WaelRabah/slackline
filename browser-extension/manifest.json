{
  "manifest_version": 3,
  "name": "Slackline Login",
  "version": "0.1.0",
  "description": "Connect your chosen Slack session to a local slackline login.",
  "permissions": ["cookies", "storage", "tabs"],
  "host_permissions": ["https://*.slack.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["http://127.0.0.1/*"], "js": ["connect.js"], "run_at": "document_idle"},
    {"matches": ["https://*.slack.com/client/*"], "js": ["session.js"], "run_at": "document_idle"}
  ]
}
